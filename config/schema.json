{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Streaming config v3",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "description": "En vivo uses m3uUrl; Canales uses xtream. liveMode is legacy.",
      "properties": {
        "liveMode": {
          "enum": ["gist", "xtream", "merge"]
        },
        "m3uUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "xtream": {
          "type": "object",
          "required": ["baseUrl", "username", "password"],
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^https?://"
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            },
            "minCategoryItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "hideEmptyCategories": {
              "type": "boolean"
            }
          }
        }
      },
      "anyOf": [
        { "required": ["m3uUrl"] },
        { "required": ["xtream"] }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wifiOnly": {
          "type": "boolean"
        },
        "maxBitrateKbps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "connectTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "readTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userAgent": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bufferMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "preBufferMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000
        },
        "minBufferMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "maxBufferMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retryDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "reconnect": {
          "type": "boolean"
        },
        "qualityCap": {
          "enum": ["auto", "1080p", "720p", "480p", "360p"]
        },
        "qualityPreference": {
          "enum": ["auto", "1080p", "720p", "480p", "360p"]
        },
        "liveLowLatency": {
          "type": "boolean"
        },
        "aspectMode": {
          "enum": ["fit", "fill", "stretch", "zoom", "original"]
        },
        "audioOnly": {
          "type": "boolean"
        },
        "sleepTimerMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vodEnabled": {
          "type": "boolean"
        },
        "sizeMb": {
          "enum": [100, 250, 500]
        },
        "clearOnStart": {
          "type": "boolean"
        }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startLastChannel": {
          "type": "boolean"
        },
        "zapping": {
          "type": "boolean"
        }
      }
    },
    "epg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": ["string", "null"],
          "pattern": "^https?://"
        },
        "refreshHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      }
    },
    "epgUrl": {
      "type": ["string", "null"],
      "pattern": "^https?://"
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiKey": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["es", "en"] }
        },
        "autoDownload": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showStats": {
          "type": "boolean"
        },
        "logLevel": {
          "enum": ["debug", "info", "warn", "error"]
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["live", "channels", "movies", "series"]
          }
        },
        "theme": {
          "enum": ["dark", "light", "system"]
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.5
        },
        "uiScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.5
        },
        "navigation": {
          "enum": ["top", "rail"]
        },
        "playerBar": {
          "enum": ["full", "compact"]
        },
        "playerButtons": {
          "type": "array",
          "items": {
            "enum": ["info", "aspect", "tracks", "quality", "speed", "external"]
          }
        },
        "showChannelNumbers": {
          "type": "boolean"
        },
        "showLogos": {
          "type": "boolean"
        },
        "showNowNext": {
          "type": "boolean"
        }
      }
    },
    "forceUpdate": {
      "type": "boolean"
    }
  }
}

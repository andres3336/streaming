                <mxCell id="legend-footer" parent="layer-notes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;fontFamily=Helvetica;" value="Archivos: un .drawio por pantalla. Páginas: leyenda, viewport, scroll completo y estados secundarios. El XML está sin comprimir para que sea legible y editable." vertex="1">

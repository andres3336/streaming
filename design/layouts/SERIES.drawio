        <mxCell id="ids-body" value="Cada bloque lógico es un grupo con un id estable y atributos de datos:&lt;br&gt;&lt;br&gt;&lt;b&gt;element&lt;/b&gt; = nombre lógico (ej. &lt;font color='#1A73E8'&gt;movies.hero&lt;/font&gt;)&lt;br&gt;&lt;b&gt;source&lt;/b&gt; = archivo/línea de referencia en Compose&lt;br&gt;&lt;br&gt;Las etiquetas azules &lt;font color='#1A73E8'&gt;[elemento]&lt;/font&gt; están en la capa &lt;b&gt;Etiquetas de elemento&lt;/b&gt; (oculta por defecto). La capa &lt;b&gt;Anotaciones&lt;/b&gt; contiene las notas de página; la capa &lt;b&gt;Medidas&lt;/b&gt; está oculta.&lt;br&gt;&lt;br&gt;Para editar: activa/desactiva capas en el panel derecho; mueve o redimensiona formas; edita el texto con doble clic. Para cambios de estructura, añade una nota o conserva el atributo &lt;b&gt;element&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#111111;fontFamily=Helvetica;" vertex="1" parent="layer-notes">
          <mxGeometry x="816" y="180" width="688" height="300" as="geometry" />
        </mxCell>
        <mxCell id="legend-note" value="Series comparte la parrilla y el hero con Películas. La ficha de serie añade la lista de temporadas y episodios; el episodio abre el player con cola para el siguiente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF8E1;strokeColor=#C9A227;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="layer-notes">
          <mxGeometry x="816" y="490" width="688" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legend-footer" value="Archivos: un .drawio por pantalla. Páginas: leyenda, viewport, scroll completo y estados secundarios. El XML está sin comprimir para que sea legible y editable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;fontFamily=Helvetica;" vertex="1" parent="layer-notes">

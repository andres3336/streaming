        <mxCell id="ids" parent="layer-notes" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1;fontFamily=Helvetica;" value="" vertex="1">
